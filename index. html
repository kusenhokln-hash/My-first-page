<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gilbert Kipkurui | Personal Webpage</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: Arial, sans-serif;
      background: #f1f7f3;
      color: #17251d;
      line-height: 1.6;
    }
    header {
      min-height: 55vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 60px 20px;
      color: white;
      background: linear-gradient(135deg, #063b2a, #0b5d3f, #111);
      background-size: 200% 200%;
      animation: headerGlow 8s ease infinite;
    }
    @keyframes headerGlow {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    header h1 { font-size: clamp(2.4rem, 8vw, 4.5rem); margin-bottom: 12px; }
    header p { font-size: clamp(1.1rem, 4vw, 1.5rem); opacity: .92; }
    nav {
      position: sticky;
      top: 0;
      z-index: 10;
      background: #071c14;
      padding: 12px;
      text-align: center;
    }
    nav a {
      color: white;
      text-decoration: none;
      margin: 0 12px;
      font-weight: bold;
      transition: color .25s;
    }
    nav a:hover { color: #7ee2a8; }
    main {
      max-width: 950px;
      margin: 0 auto;
      padding: 45px 18px;
    }
    section {
      background: white;
      border-radius: 22px;
      padding: 38px 28px;
      margin-bottom: 28px;
      box-shadow: 0 10px 28px rgba(0,0,0,.08);
      transition: transform .25s, box-shadow .25s;
    }
    section:hover {
      transform: translateY(-5px);
      box-shadow: 0 16px 35px rgba(0,0,0,.12);
    }
    h2 {
      color: #075c3d;
      margin-bottom: 18px;
      text-align: center;
      font-size: 2rem;
    }
    .skills {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
    }
    .skill {
      background: #e0f3e7;
      border-left: 5px solid #0b6b46;
      padding: 16px;
      border-radius: 12px;
      font-weight: bold;
      transition: transform .2s;
    }
    .skill:hover { transform: scale(1.03); }
    .contact {
      text-align: center;
      background: #0a3d2b;
      color: white;
    }
    .contact h2 { color: white; }
    .contact a { color: #9bf0bd; }
    footer {
      text-align: center;
      padding: 28px 15px;
      background: #071c14;
      color: white;
    }
    @media (max-width: 600px) {
      section { padding: 30px 20px; }
      nav a { margin: 0 6px; font-size: .9rem; }
    }
  </style>
</head>
<body>

  <header>
    <div>
      <h1>Gilbert Kipkurui</h1>
      <p>Welcome to my personal webpage</p>
    </div>
  </header>

  <nav>
    <a href="#about">About Me</a>
    <a href="#skills">Skills</a>
    <a href="#contact">Contact</a>
  </nav>

  <main>
    <section id="about">
      <h2>About Me</h2>
      <p>
        I am a graduate in Agriculture and Biotechnology with an interest in
        farming, technology, web development, and learning new skills.
        I enjoy exploring practical ideas that connect agriculture with modern technology.
      </p>
    </section>

    <section id="skills">
      <h2>My Skills & Interests</h2>
      <div class="skills">
        <div class="skill">🌱 Agriculture</div>
        <div class="skill">🧬 Biotechnology</div>
        <div class="skill">💻 Web Development</div>
        <div class="skill">📱 Computer Skills</div>
        <div class="skill">🌾 Sustainable Farming</div>
        <div class="skill">📚 Continuous Learning</div>
      </div>
    </section>

    <section id="contact" class="contact">
      <h2>Contact</h2>
      <p>Interested in agriculture, technology, or learning together?</p>
      <p><a href="mailto:kipkuruig63@gmail.com">Contact me by email</a></p>
    </section>
  </main>

  <footer>
    <p>© 2026 Gilbert Kipkurui. Built while learning web development.</p>
  </footer>

</body>
</html>
